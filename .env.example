# 複製成 .env 後填入。任何 OpenAI 相容(/chat/completions)的服務都可以。

# OpenAI(預設)
API_BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=gpt-4o-mini

# 其他例子:
# OpenRouter  API_BASE_URL=https://openrouter.ai/api/v1       MODEL=anthropic/claude-sonnet-4.5
# DeepSeek    API_BASE_URL=https://api.deepseek.com/v1        MODEL=deepseek-chat
# Ollama      API_BASE_URL=http://localhost:11434/v1          MODEL=qwen2.5:7b   (API_KEY 可留空)
# LM Studio   API_BASE_URL=http://localhost:1234/v1           MODEL=(載入的模型名稱)

TEMPERATURE=0.8
PORT=3000
